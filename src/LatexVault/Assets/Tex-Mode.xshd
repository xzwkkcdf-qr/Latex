<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="TeX" extensions=".tex" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A737D" />
  <Color name="Command" foreground="#005CC5" />
  <Color name="Math" foreground="#E36209" />
  <Color name="Brace" foreground="#24292E" />
  <RuleSet ignoreCase="false">
    <Span color="Comment" begin="%" ruleSet="CommentSet" />
    <Span color="Math" ruleSet="MathSet">
      <Begin>\$</Begin>
      <End>\$</End>
    </Span>
    <Keywords color="Brace">
      <Word>{</Word>
      <Word>}</Word>
    </Keywords>
    <Rule color="Command">\\[a-zA-Z@]+</Rule>
    <Rule color="Command">\\[^a-zA-Z@]</Rule>
  </RuleSet>
  <RuleSet name="CommentSet">
    <!-- rest of line is comment via Span begin=% without end -->
  </RuleSet>
  <RuleSet name="MathSet">
    <Rule color="Command">\\[a-zA-Z@]+</Rule>
  </RuleSet>
</SyntaxDefinition>