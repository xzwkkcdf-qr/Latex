<Window x:Class="LatexVault.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource LatexVaultPaperBrush}"
        FontFamily="{DynamicResource LatexVaultBodyFont}"
        Foreground="{DynamicResource LatexVaultInkBrush}"
        ShowInTaskbar="False">
    <Border BorderBrush="{DynamicResource LatexVaultInkBrush}" BorderThickness="1" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="1" Height="14" VerticalAlignment="Center"
                        Background="{DynamicResource LatexVaultInkBrush}" Margin="0,0,10,0"/>
                <TextBlock x:Name="TitleText"
                           FontFamily="{DynamicResource LatexVaultDisplayFont}"
                           FontSize="18"
                           Text="Confirm"/>
            </StackPanel>
            <TextBlock Grid.Row="1"
                       x:Name="MessageText"
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       FontSize="13"
                       Foreground="{DynamicResource LatexVaultMutedInkBrush}"
                       Margin="0,0,0,20"/>
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="PrimaryButton"
                        Content="Save"
                        Style="{DynamicResource LatexVaultPrimaryActionStyle}"
                        Margin="0,0,8,0"
                        Click="PrimaryButton_Click"/>
                <Button x:Name="SecondaryButton"
                        Content="Don't Save"
                        Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                        Margin="0,0,8,0"
                        Click="SecondaryButton_Click"/>
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>