<UserControl x:Class="LatexVault.Views.Controls.PdfPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border BorderBrush="{DynamicResource LatexVaultLineBrush}"
            BorderThickness="1"
            Background="{DynamicResource LatexVaultPaperMutedBrush}"
            Margin="0,0,0,12"
            Padding="1">
        <Image x:Name="PageImage"
               Stretch="None"
               HorizontalAlignment="Center"
               SnapsToDevicePixels="True"/>
    </Border>
</UserControl>
