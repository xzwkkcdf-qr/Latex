<UserControl x:Class="LatexVault.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:LatexVault.Models"
             xmlns:controls="clr-namespace:LatexVault.Views.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource LatexVaultPaperBrush}"
             FontFamily="{DynamicResource LatexVaultBodyFont}"
             Foreground="{DynamicResource LatexVaultInkBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource LatexVaultLineBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Import TeX"
                        Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                        Command="{Binding ImportTexCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Save"
                        Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Compile"
                        Style="{DynamicResource LatexVaultPrimaryActionStyle}"
                        Command="{Binding Compile.CompileCommand}"
                        Margin="0,0,12,0"/>
                <ComboBox Width="140"
                          Style="{DynamicResource LatexVaultComboBoxStyle}"
                          ItemsSource="{Binding Compile.EngineOptions}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Engine"
                          SelectedValue="{Binding Compile.SelectedEngine}"
                          Margin="0,0,8,0"/>
                <Button Content="Toggle Preview"
                        Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                        Command="{Binding TogglePreviewCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Settings"
                        Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                        Command="{Binding OpenSettingsCommand}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" x:Name="LibraryCol"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="360" MinWidth="160" x:Name="PreviewCol"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="16,12,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="1" Height="12" VerticalAlignment="Center"
                                Background="{DynamicResource LatexVaultInkBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="LIBRARY"
                                   Style="{DynamicResource LatexVaultDrawerKickerStyle}"
                                   Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Library.RootName}"
                               Style="{DynamicResource LatexVaultDrawerChapterTitleStyle}"
                               Margin="0,4,0,8"/>
                </StackPanel>
                <TextBox Grid.Row="1"
                         Style="{DynamicResource LatexVaultTextBoxStyle}"
                         Text="{Binding Library.FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8"
                         ToolTip="Filter by name"/>
                <TreeView x:Name="LibraryTree"
                          Grid.Row="2"
                          ItemsSource="{Binding Library.Nodes}"
                          BorderThickness="0"
                          Background="Transparent"
                          AllowDrop="True">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                            <Setter Property="Padding" Value="2,1"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type models:LibraryNode}"
                                                  ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                    <Button Content="New Tex"
                            Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                            Command="{Binding NewTexCommand}"
                            Margin="0,0,8,4"/>
                    <Button Content="New Folder"
                            Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                            Command="{Binding NewFolderCommand}"
                            Margin="0,0,8,4"/>
                    <Button Content="Rename"
                            Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                            Command="{Binding RenameNodeCommand}"
                            Margin="0,0,8,4"/>
                    <Button Content="Delete"
                            Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                            Command="{Binding DeleteNodeCommand}"
                            Margin="0,0,8,4"/>
                </WrapPanel>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource LatexVaultLineBrush}"/>

            <Grid Grid.Column="2" Margin="8,12,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TabControl ItemsSource="{Binding Editor.Tabs}"
                            SelectedItem="{Binding Editor.SelectedTab}"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource LatexVaultLineBrush}"
                            Background="Transparent">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Title}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Title, StringFormat={}{0} •}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                    <Setter Property="Foreground" Value="#AA0000"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="×"
                                        Margin="8,0,0,0"
                                        Padding="4,0"
                                        FontSize="12"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="CloseTabButton_Click"
                                        ToolTip="Close tab"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
                <controls:AvalonEditHost Grid.Row="1"
                                         Text="{Binding Editor.SelectedTab.Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         Margin="0,8,0,0"/>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource LatexVaultLineBrush}"
                          Visibility="{Binding Preview.IsVisible, Converter={StaticResource BoolToVis}}"/>

            <Grid Grid.Column="4" Margin="8,12,16,8"
                  Visibility="{Binding Preview.IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="1" Height="12" VerticalAlignment="Center"
                            Background="{DynamicResource LatexVaultInkBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="PREVIEW"
                               Style="{DynamicResource LatexVaultDrawerKickerStyle}"
                               Margin="0"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button Content="-" Width="28" Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                            Command="{Binding Preview.ZoomOutCommand}" ToolTip="Zoom out" Margin="0,0,4,4"/>
                    <Button Content="{Binding Preview.ZoomText}" MinWidth="52"
                            Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                            Command="{Binding Preview.ZoomResetCommand}"
                            ToolTip="Reset zoom (Ctrl+wheel)" Margin="0,0,4,4"/>
                    <Button Content="+" Width="28" Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                            Command="{Binding Preview.ZoomInCommand}" ToolTip="Zoom in" Margin="0,0,8,4"/>
                    <Button Content="Pages" Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                            Command="{Binding Preview.ExportPagesCommand}"
                            ToolTip="Export one PNG per page" Margin="0,0,4,4"/>
                    <Button Content="Strip" Style="{DynamicResource LatexVaultSecondaryActionStyle}"
                            Command="{Binding Preview.ExportVerticalCommand}"
                            ToolTip="Export vertical stitch PNG" Margin="0,0,4,4"/>
                </WrapPanel>
                <Grid Grid.Row="2">
                    <Border x:Name="PdfHost"
                            BorderBrush="{DynamicResource LatexVaultLineBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource LatexVaultPaperMutedBrush}">
                        <wv2:WebView2 x:Name="PdfWebView"
                                      DefaultBackgroundColor="Transparent"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Preview.IsEmpty}" Value="True"/>
                                            <Condition Binding="{Binding Preview.IsLoading}" Value="False"/>
                                            <Condition Binding="{Binding Compile.IsCompiling}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No preview"
                                   FontFamily="{DynamicResource LatexVaultDisplayFont}"
                                   FontSize="18"
                                   Foreground="{DynamicResource LatexVaultInkBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Preview.Hint}"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource LatexVaultMutedInkBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="220"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" Margin="16,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Compile.IsCompiling}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Preview.IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ProgressBar Height="2"
                                     IsIndeterminate="True"
                                     BorderThickness="0"
                                     Background="{DynamicResource LatexVaultLineBrush}"
                                     Foreground="{DynamicResource LatexVaultInkBrush}"/>
                        <TextBlock Text="{Binding Preview.Hint}"
                                   FontSize="12"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource LatexVaultMutedInkBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource LatexVaultLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8"
                Visibility="{Binding Compile.IsLogOpen, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Height" Value="160"/>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="1" Height="12" VerticalAlignment="Center"
                            Background="{DynamicResource LatexVaultInkBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="COMPILE LOG"
                               Style="{DynamicResource LatexVaultDrawerKickerStyle}"
                               Margin="0"/>
                </StackPanel>
                <TextBox Grid.Row="1"
                         Style="{DynamicResource LatexVaultTextBoxStyle}"
                         FontFamily="{DynamicResource LatexVaultMonoFont}"
                         FontSize="11"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         x:Name="CompileLogBox"
                         Text="{Binding Compile.LastLog, Mode=OneWay, NotifyOnTargetUpdated=True}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="{DynamicResource LatexVaultLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource LatexVaultMutedInkBrush}"
                               Text="{Binding StatusMessage}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0"/>
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource LatexVaultMutedInkBrush}"
                               Text="{Binding StatusPath}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Margin="16,0"
                           Foreground="{DynamicResource LatexVaultMutedInkBrush}"
                           Text="{Binding Compile.StatusText}"
                           Cursor="Hand"
                           ToolTip="Toggle compile log"
                           MouseLeftButtonUp="CompileStatus_MouseLeftButtonUp"/>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource LatexVaultMutedInkBrush}"
                           Text="{Binding Compile.SelectedEngine}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>