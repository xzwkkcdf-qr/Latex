<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Color x:Key="LatexVaultInkColor">#111111</Color>
    <Color x:Key="LatexVaultPaperColor">#FFFFFF</Color>
    <Color x:Key="LatexVaultPaperMutedColor">#F2F2F2</Color>
    <Color x:Key="LatexVaultLineColor">#D6D6D6</Color>
    <Color x:Key="LatexVaultAccentColor">#111111</Color>
    <Color x:Key="LatexVaultAlertColor">#111111</Color>
    <Color x:Key="LatexVaultImageWellColor">#0A0A0A</Color>

    <SolidColorBrush x:Key="LatexVaultInkBrush" Color="{StaticResource LatexVaultInkColor}"/>
    <!-- 次级墨色：纸面上的说明性文字与状态尾注，比结构线更深、比正文更浅 -->
    <SolidColorBrush x:Key="LatexVaultMutedInkBrush" Color="#6D6D6D"/>
    <SolidColorBrush x:Key="LatexVaultPaperBrush" Color="{StaticResource LatexVaultPaperColor}"/>
    <SolidColorBrush x:Key="LatexVaultPaperMutedBrush" Color="{StaticResource LatexVaultPaperMutedColor}"/>
    <SolidColorBrush x:Key="LatexVaultLineBrush" Color="{StaticResource LatexVaultLineColor}"/>
    <SolidColorBrush x:Key="LatexVaultAccentBrush" Color="{StaticResource LatexVaultAccentColor}"/>
    <SolidColorBrush x:Key="LatexVaultAlertBrush" Color="{StaticResource LatexVaultAlertColor}"/>
    <SolidColorBrush x:Key="LatexVaultImageWellBrush" Color="{StaticResource LatexVaultImageWellColor}"/>

    <FontFamily x:Key="LatexVaultBodyFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="LatexVaultDisplayFont">Georgia, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="LatexVaultDataFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <!-- 指标数字等宽：小数点纵向对齐 -->
    <FontFamily x:Key="LatexVaultMonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <!-- 载入进度等数字 HUD：无衬线；本机有 IBM Plex Sans / Inter 时优先 -->
    <FontFamily x:Key="LatexVaultProgressFont">IBM Plex Sans, Inter, Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <Thickness x:Key="LatexVaultShellPadding">32</Thickness>
    <sys:Double x:Key="LatexVaultToolbarHeight">48</sys:Double>
    <sys:Double x:Key="LatexVaultDrawerWidth">280</sys:Double>
    <Duration x:Key="LatexVaultMotionDuration">0:0:0.18</Duration>
    <Duration x:Key="LatexVaultMotionFastDuration">0:0:0.12</Duration>
    <Color x:Key="LatexVaultStructureLineColor">#C8C8C8</Color>
    <Color x:Key="LatexVaultFocusStrokeColor">#111111</Color>
    <SolidColorBrush x:Key="LatexVaultStructureLineBrush" Color="{StaticResource LatexVaultStructureLineColor}"/>
    <SolidColorBrush x:Key="LatexVaultFocusStrokeBrush" Color="{StaticResource LatexVaultFocusStrokeColor}"/>
    <sys:Double x:Key="LatexVaultMotionStaggerMs">48</sys:Double>
</ResourceDictionary>
